{
  "name": "@quartz-themes/core",
  "version": "3.1.1",
  "description": "Quartz transformer plugin: use any Obsidian community theme, converted at build time.",
  "type": "module",
  "license": "MIT",
  "author": "saberzero1",
  "homepage": "https://github.com/quartz-themes/core",
  "repository": {
    "type": "git",
    "url": "https://github.com/quartz-themes/core.git"
  },
  "keywords": [
    "quartz",
    "quartz-plugin",
    "obsidian",
    "themes",
    "css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --test --import tsx src/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "generate": "tsx scripts/generate.ts"
  },
  "peerDependencies": {
    "lightningcss": "^1.31.1",
    "preact": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    }
  },
  "dependencies": {
    "@quartz-community/types": "^1.0.0"
  },
  "devDependencies": {
    "@lucide/icons": "^1.7.0",
    "@types/css-tree": "^2.3.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.0",
    "css-tree": "^3.1.0",
    "js-yaml": "^4.1.0",
    "lightningcss": "^1.31.1",
    "postcss": "^8.5.6",
    "postcss-safe-parser": "^7.0.1",
    "postcss-selector-parser": "^7.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "quartz": {
    "name": "@quartz-themes/core",
    "displayName": "Quartz Themes",
    "category": "transformer",
    "version": "1.0.0",
    "quartzVersion": ">=5.2.0",
    "dependencies": [],
    "defaultOrder": 10,
    "defaultEnabled": true,
    "defaultOptions": {
      "theme": "Tokyo Night",
      "mode": "both",
      "themeFonts": true
    },
    "optionSchema": {
      "theme": {
        "type": "string"
      },
      "mode": {
        "type": "enum",
        "values": [
          "dark",
          "light",
          "both"
        ]
      },
      "styleSettings": {
        "type": "object"
      },
      "snippets": {
        "type": "array"
      },
      "version": {
        "type": "string"
      },
      "themeFonts": {
        "type": "boolean"
      },
      "cacheDir": {
        "type": "string"
      },
      "cacheHours": {
        "type": "number"
      },
      "variation": {
        "type": "string"
      }
    }
  },
  "engines": {
    "node": ">=22"
  }
}
